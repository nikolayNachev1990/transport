server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name localhost _;
    server_tokens off;

    client_max_body_size 0;
    access_log /dev/stdout;
    access_log /home/nginx-logs/default-access.log;
    error_log /home/nginx-logs/default-error.log;
    error_log /dev/stderr warn;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 30s;
    root /usr/share/nginx/html;

    index index.html;

    # =========================
    # DOZZLE
    # =========================
    location /dozzle {
        return 301 /dozzle/;
    }
    location ^~ /dozzle/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_set_header X-Real-IP $${ESC}remote_addr;
        proxy_set_header X-Forwarded-For $${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $${ESC}scheme;
        proxy_set_header Host $${ESC}http_host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $${ESC}http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_pass http://dozzle:8080;
        rewrite ^/dozzle/(.*)$ /dozzle/$${ESC}1 break;
        chunked_transfer_encoding off;
        proxy_buffering off;
        proxy_cache off;
        error_page 502 504 = @custom_error;
    }
    # =========================
    # ADMINER
    # =========================
    location /adminer {
        return 301 /adminer/;
    }
    location ^~ /adminer/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_set_header X-Real-IP $${ESC}remote_addr;
        proxy_set_header X-Forwarded-For $${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $${ESC}scheme;
        proxy_set_header Host $${ESC}http_host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $${ESC}http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_pass http://adminer:8080;
        rewrite ^/adminer/(.*)$ /$${ESC}1 break;
        chunked_transfer_encoding off;
        proxy_buffering off;
        proxy_cache off;
        error_page 502 504 = @custom_error;
    }
    # =========================
    # DEFAULT NGINX PAGE
    # =========================
    location / {
        try_files $${ESC}uri $${ESC}uri/ =404;
    }
    # =========================
    # CUSTOM ERROR
    # =========================
    location @custom_error {
        default_type text/plain;
        return 503 'Service not available';
    }
}

