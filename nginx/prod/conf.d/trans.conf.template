# WEBSITE :::::::::::::::::::::::::::::::
server {
  listen 80;
  server_name ${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT};
  server_tokens off;
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  
  location / {
    return 301 https://${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT}$${ESC}request_uri;
  }
}

server {
  listen 80;
  server_name app.${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT};
  server_tokens off;
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  
  location / {
    return 301 https://${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT}$${ESC}request_uri;
  }
}

server {
  listen 80;
  server_name www.${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT};
  server_tokens off;
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  
  location / {
    return 301 https://${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT}$${ESC}request_uri;
  }
}

server {

  # common ......
  listen 443 ssl http2;
  server_name ${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT};

  # ssl ......
  ssl_certificate /etc/letsencrypt/live/${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT}/privkey.pem;

  # disable checking client body size
  client_max_body_size 0;
  
  # log ......
  access_log /var/log/access.log;
  error_log /var/log/error.log;

  # certbot ......
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  # docker internal DNS ......
    resolver 127.0.0.11;
    resolver_timeout 30s;

  location / {
        set $${ESC}inner_nginx http://trapflix-nginx:8002;
        proxy_pass $${ESC}inner_nginx;
        proxy_http_version 1.1;
        proxy_set_header Host $${ESC}host;
        proxy_set_header X-Real-IP $${ESC}remote_addr;
        proxy_set_header X-Forwarded-For $${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $${ESC}host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $${ESC}http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_buffering off;
        proxy_intercept_errors on;
        error_page 502 503 504 @custom_error;
    }
    location @custom_error {
        default_type text/plain;
        return 503 'Service is not available';
    }
}

server {

  # common ......
  listen 443 ssl http2;
  server_name app.${COMPOSE_PROJECT_NAME}.${DOMAIN_EXT};

  # ssl ......
