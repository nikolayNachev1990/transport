map $${ESC}http_upgrade $${ESC}connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name localhost _;
    server_tokens off;

    client_max_body_size 0;
    access_log /dev/stdout;
    access_log /home/nginx-logs/default-access.log;
    error_log /home/nginx-logs/default-error.log;
    error_log /dev/stderr warn;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 30s;
    root /usr/share/nginx/html;

    index index.html;

    
    # =========================
    # DEFAULT NGINX PAGE
    # =========================
    location / {
        try_files $${ESC}uri $${ESC}uri/ =404;
    }
    # =========================
    # CUSTOM ERROR
    # =========================
    location @custom_error {
        default_type text/plain;
        return 503 'Service not available';
    }
}

server {
    listen 443 ssl http2 default_server;
    server_name localhost _;
    server_tokens off;

    client_max_body_size 0;
    access_log /dev/stdout;
    access_log /home/nginx-logs/default-access.log;
    error_log /home/nginx-logs/default-error.log;
    error_log /dev/stderr warn;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 30s;
    root /usr/share/nginx/html;

    index index.html;

    ssl_certificate     /etc/nginx/ssl/default-selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/default-selfsigned.key;

    # =========================
    # DEFAULT NGINX PAGE
    # =========================
    location / {
        try_files $${ESC}uri $${ESC}uri/ =404;
    }
    # =========================
    # CUSTOM ERROR
    # =========================
    location @custom_error {
        default_type text/plain;
        return 503 'Service not available';
    }
}