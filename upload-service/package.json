{
  "name": "upload-service",
  "version": "1.0.0",
  "description": "Presigned-URL file uploads against S3-compatible storage (Cloudflare R2 in production, MinIO locally)",
  "main": "./dist/index.mjs",
  "scripts": {
    "dev": "nodemon",
    "prod": "node ./dist/index.mjs",
    "migrate": "node --no-warnings=ExperimentalWarning --experimental-strip-types --import ./dev-hooks.mjs ./src/migrate.mts"
  },
  "author": "Vladislav Radev",
  "license": "ISC",
  "dependencies": {
    "@transport/core": "file:./core",
    "express": "5.2.1",
    "glob": "10.5.0",
    "moment": "2.30.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "nodemon": "3.1.14",
    "typescript": "7.0.2"
  }
}
