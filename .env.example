# Local development environment template. Copy to .env and fill in the
# placeholders below — real values are never committed (see .gitignore).
# Structural values (ports, service/group names, RAM limits, hostnames)
# are kept as-is since they aren't secrets and match docker-compose.yaml.

# COMMON ..................................................
NETWORK_MAIN_NAME=transport
DOCKER_MODE=development
MODE=development
NODE_TLS_REJECT_UNAUTHORIZED=1
COMPOSE_PROJECT_NAME=transport

WEB_APP_URL=http://localhost:3000
APP_URL=http://localhost

# HEALTHCHECK: generic services ...........................
HEALTHCHECK_SERVICE_URL=http://localhost/health
HEALTHCHECK_SERVICE_INTERVAL=10s
HEALTHCHECK_SERVICE_TIMEOUT=5s
HEALTHCHECK_SERVICE_RETRIES=5

# HEALTHCHECK: databases ...................................
HEALTHCHECK_DB_INTERVAL=5s
HEALTHCHECK_DB_TIMEOUT=5s
HEALTHCHECK_DB_RETRIES=5

POSTGRES_VERSION=17-alpine

# REDIS ....................................................
REDIS_HOST=redis
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379

# KAFKA (shared) ...........................................
KAFKA_RAM_MAX=1000M
KAFKA_RAM_RESERVED=256M
KAFKA_KRAFT_CLUSTER_ID=changeme-generate-a-kraft-cluster-id
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=1@kafka-1:9093,2@kafka-2:9093
KAFKA_CFG_OFFSETS_TOPIC_REPLICATION_FACTOR=2
KAFKA_BROKERS_HOSTS=kafka-1:9092,kafka-2:9092

# KAFKA 1 ..................................................
KAFKA_1_HOST=kafka-1
KAFKA_1_CFG_NODE_ID=1
KAFKA_1_CFG_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_1_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka-1:9092

# KAFKA 2 ..................................................
KAFKA_2_HOST=kafka-2
KAFKA_2_CFG_NODE_ID=2
KAFKA_2_CFG_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_2_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka-2:9092

# AUTH: service .............................................
AUTH_SERVICE_NAME=auth-service
AUTH_SERVICE_RAM_MAX=768M
AUTH_SERVICE_RAM_RESERVED=256M
AUTH_KAFKA_GROUP=auth-group
AUTH_KAFKA_GROUP_ID=auth-1-client

# ACCESS_TOKEN [1 hour]
AUTH_SERVICE_ACCESS_TOKEN_LIFETIME=3600
# REFRESH_TOKEN [2 weeks]
AUTH_SERVICE_REFRESH_TOKEN_LIFETIME=1209600
# COOKIE_TTL [2 weeks]
AUTH_SERVICE_COOKIE_TTL_LIFETIME=1209600
AUTH_SERVICE_LOGIN_LIMIT=1000

# JWT keypair — generate your own for local dev, e.g.:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Never reuse the same keypair across environments.
AUTH_SERVICE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchangeme\n-----END PRIVATE KEY-----"
AUTH_SERVICE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nchangeme\n-----END PUBLIC KEY-----"

# AUTH: locale (SERVICE_LANGS_*) — ./langs is the shared langs/ folder
# copied into every service's image/container at the same relative path.
SERVICE_LANGS=en
SERVICE_LANGS_DIRECTORY=./langs
SERVICE_LANGS_DEFAULTLOCALE=en
SERVICE_LANGS_HEADER=x-locale
SERVICE_LANGS_QUERYPARAMETER=locale

# AUTH: primary database (Postgresql) .........................
AUTH_DB_RAM_MAX=256M
AUTH_DB_RAM_RESERVED=128M
AUTH_DB_NAME=authdb
AUTH_DB_USER=postgres
AUTH_DB_PASS=changeme
AUTH_DB_URL=postgres://postgres:changeme@auth-db:5432/authdb

# AUTH: social login — leave empty if not needed locally.
AUTH_SERVICE_LOGIN_CALLBACK_BASE_URL=http://localhost/auth/callback
AUTH_SERVICE_LOGIN_REDIRECT_URL_WEB=http://localhost:3000
AUTH_SERVICE_LOGIN_REDIRECT_URL_EXPO=
AUTH_SERVICE_GOOGLE_LOGIN_CLIENT_ID=
AUTH_SERVICE_GOOGLE_LOGIN_CLIENT_SECRET=
AUTH_SERVICE_APPLE_LOGIN_CLIENT_ID=
AUTH_SERVICE_APPLE_LOGIN_TEAM_ID=
AUTH_SERVICE_APPLE_LOGIN_KEY_ID=
AUTH_SERVICE_APPLE_LOGIN_KEY_FILEPATH=
AUTH_SERVICE_FACEBOOK_LOGIN_CLIENT_ID=
AUTH_SERVICE_FACEBOOK_LOGIN_CLIENT_SECRET=
AUTH_SERVICE_DISCORD_LOGIN_CLIENT_ID=
AUTH_SERVICE_DISCORD_LOGIN_CLIENT_SECRET=
AUTH_SERVICE_REDDIT_LOGIN_CLIENT_ID=
AUTH_SERVICE_REDDIT_LOGIN_CLIENT_SECRET=
AUTH_SERVICE_AUTHORIZATION_CODE_REDIRECT_URL=http://localhost/auth/authorize/callback

# AUTH: SMS (Twilio) — disabled, not needed to see db/redis/kafka connect.
TWILIO_STATUS=false
TWILIO_FROM_NAME=Transport
TWILIO_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# S3-compatible storage — minio locally (below), Cloudflare R2 in
# production (S3_TYPE=s3, S3_ENDPOINT(_IN_DOCKER)=https://<account>.r2.cloudflarestorage.com,
# S3_REGION=auto). Shared by auth-service (avatars) and upload-service.
S3_TYPE=minio
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=transport
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ENDPOINT_IN_DOCKER=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# doc-service's own S3 credentials — a separate MinIO user with a
# GetObject-only policy (SPEC-doc-service.md §7, provisioned by
# minio-setup), not S3_ACCESS_KEY/S3_SECRET_KEY above. In production
# this is a real scoped IAM key, not a shared admin one.
DOC_S3_ACCESS_KEY=changeme
DOC_S3_SECRET_KEY=changeme

CRON_TIMEOUT=15

# AUTH: bootstrap admin user — read by src/seeds/*_users.js.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
ADMIN_USER_NAME=admin
ADMIN_USER_EMAIL=admin@transport.local
ADMIN_USER_PASS=changeme
ADMIN_USER_ROLE=admin

# AUTH: bootstrap moderator user — same pattern as ADMIN_USER_*.
MODERATOR_USER_ID=00000000-0000-0000-0000-000000000002
MODERATOR_USER_NAME=moderator
MODERATOR_USER_EMAIL=moderator@transport.local
MODERATOR_USER_PASS=changeme
MODERATOR_USER_ROLE=moderator

# QUERY: service
QUERY_SERVICE_NAME=query-service
QUERY_SERVICE_RAM_MAX=512M
QUERY_SERVICE_RAM_RESERVED=128M
QUERY_KAFKA_GROUP=query-group
QUERY_KAFKA_GROUP_ID=query-1-client

# QUERY: primary database (Postgresql) .........................
QUERY_DB_RAM_MAX=256M
QUERY_DB_RAM_RESERVED=128M
QUERY_DB_NAME=querydb
QUERY_DB_USER=postgres
QUERY_DB_PASS=changeme
QUERY_DB_URL=postgres://postgres:changeme@query-db:5432/querydb

# HASURA ...................................................
HASURA_PORTS=8080
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup, http-log, webhook-log, websocket-log, query-log
HASURA_GRAPHQL_ADMIN_SECRET=changeme
# Calls auth-service's own hasura/webhook endpoint (src/auth/rest/hasuraWebhook.mts)
# to resolve X-Hasura-Role/User-Id from the caller's Bearer token.
HASURA_GRAPHQL_AUTH_HOOK=http://auth-service/api/hasura/webhook
HASURA_GRAPHQL_AUTH_HOOK_MODE=GET
HASURA_GRAPHQL_RAM_MAX=1000M
HASURA_GRAPHQL_RAM_RESERVED=256M

# HASURA: metadata catalog database (separate from query-db) ..............
HASURA_DB_RAM_MAX=256M
HASURA_DB_RAM_RESERVED=128M
HASURA_DB_NAME=hasuradb
HASURA_DB_USER=postgres
HASURA_DB_PASS=changeme
HASURA_DB_URL=postgres://postgres:changeme@hasura-db:5432/hasuradb

# CORE: service — creates every Kafka topic Events/ declares, and
# dispatches scheduled cron-trigger events. No database of its own.
CORE_SERVICE_NAME=core-service
CORE_SERVICE_RAM_MAX=256M
CORE_SERVICE_RAM_RESERVED=128M
CORE_KAFKA_GROUP=core-group
CORE_KAFKA_GROUP_ID=core-1-client

# MINIO: local stand-in for Cloudflare R2 — same access/secret key pair as
# S3_ACCESS_KEY/S3_SECRET_KEY above. Console at http://localhost:9001.
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_API_PORTS=9000
MINIO_CONSOLE_PORTS=9001
MINIO_RAM_MAX=256M
MINIO_RAM_RESERVED=128M
MINIO_S3_END_POINT_IN_DOCKER=http://minio:9000
MINIO_DOCKER_COMMAND=server /data --console-address ":9001"
MINIO_BUCKET_NAME=transport

# UPLOAD: service — presigned-URL uploads against S3_* storage above.
UPLOAD_SERVICE_NAME=upload-service
UPLOAD_SERVICE_RAM_MAX=256M
UPLOAD_SERVICE_RAM_RESERVED=128M
UPLOAD_KAFKA_GROUP=upload-group
UPLOAD_KAFKA_GROUP_ID=upload-1-client
UPLOAD_STALE_QUEUE_HOURS=24
UPLOAD_PRESIGNED_URL_EXPIRE_SECONDS=900
UPLOAD_MAX_FILE_SIZE_BYTES=26214400

# UPLOAD: primary database (Postgresql) .........................
UPLOAD_DB_RAM_MAX=256M
UPLOAD_DB_RAM_RESERVED=128M
UPLOAD_DB_NAME=uploaddb
UPLOAD_DB_USER=postgres
UPLOAD_DB_PASS=changeme
UPLOAD_DB_URL=postgres://postgres:changeme@upload-db:5432/uploaddb

# INTERNAL: shared secret for service-to-service /internal/* routes (not
# reachable through Hasura) — every service that exposes or calls such a
# route reads this same value.
INTERNAL_API_SECRET=changeme

# COMPANY: service — registry of companies + their users, mints
# company_id/user_id for every other service.
COMPANY_SERVICE_NAME=company-service
COMPANY_SERVICE_RAM_MAX=256M
COMPANY_SERVICE_RAM_RESERVED=128M
COMPANY_KAFKA_GROUP=company-group
COMPANY_KAFKA_GROUP_ID=company-1-client
COMPANY_LOGO_URL_EXPIRE_SECONDS=900

# COMPANY: primary database (Postgresql) .........................
COMPANY_DB_RAM_MAX=256M
COMPANY_DB_RAM_RESERVED=128M
COMPANY_DB_NAME=companydb
COMPANY_DB_USER=postgres
COMPANY_DB_PASS=changeme
COMPANY_DB_URL=postgres://postgres:changeme@company-db:5432/companydb

# FLEET: service — owner of the physical fleet (vehicles, trailers,
# drivers, documents, compliance). See SPEC-fleet-service.md.
FLEET_SERVICE_NAME=fleet-service
FLEET_SERVICE_RAM_MAX=256M
FLEET_SERVICE_RAM_RESERVED=128M
FLEET_KAFKA_GROUP=fleet-group
FLEET_KAFKA_GROUP_ID=fleet-1-client

# FLEET: primary database (Postgresql) .........................
FLEET_DB_RAM_MAX=256M
FLEET_DB_RAM_RESERVED=128M
FLEET_DB_NAME=fleetdb
FLEET_DB_USER=postgres
FLEET_DB_PASS=changeme
FLEET_DB_URL=postgres://postgres:changeme@fleet-db:5432/fleetdb

# FLEET: field-level encryption — 64 hex chars = 32 bytes, e.g.:
#   openssl rand -hex 32
FLEET_ENCRYPTION_KEY=changeme-64-hex-chars-32-bytes-aes-256-gcm-key-0000000000000000

# DOC: service — document recognition (SPEC-doc-service.md), Python.
# Consumes fleet.extraction.requested, publishes doc.extraction.completed/
# failed + doc.ai_usage.recorded. No database of its own (stateless).
DOC_SERVICE_NAME=doc-service
DOC_SERVICE_RAM_MAX=1G
DOC_SERVICE_RAM_RESERVED=512M
DOC_KAFKA_GROUP=doc-group
DOC_KAFKA_GROUP_ID=doc-1-client
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-sonnet-5
# Second opinion, only when an answer fails validation or disagrees with the local
# reading. Empty = never escalate.
ANTHROPIC_MODEL_ESCALATION=claude-opus-5
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
OCR_LANGUAGES=bul+eng
# Work queue: parallel workers, per-company running cap, buffer size before
# consumption pauses. Each worker can hold a decoded photo — raise
# DOC_SERVICE_RAM_MAX with DOC_WORKERS.
DOC_WORKERS=2
DOC_PER_COMPANY_MAX=2
DOC_MAX_BUFFER=40
