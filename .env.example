# Copy to .env and fill in real values. .env is gitignored — never commit it.

# One dedicated Postgres CONTAINER per service (docker-compose.yml) — this
# password is that container's own POSTGRES_PASSWORD, i.e. the service's
# login role is that instance's only login role. There is no shared
# Postgres superuser anymore.
AUTH_DB_PASSWORD=change-me
FLEET_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
BILLING_DB_PASSWORD=change-me
FILES_DB_PASSWORD=change-me
TRACK_DB_PASSWORD=change-me
ROUTING_DB_PASSWORD=change-me
NOTIFY_DB_PASSWORD=change-me
AI_DB_PASSWORD=change-me
QUERY_DB_PASSWORD=change-me

# Hasura's own role: full owner rights on hasura_metadata_db (its
# internal catalog), read-only-scoped (CONNECT + schema USAGE, no table
# grants yet) on query_db.
HASURA_DB_PASSWORD=change-me
HASURA_GRAPHQL_ADMIN_SECRET=change-me

# MinIO — local/dev substitute for Cloudflare R2 (tms-core/storage points
# at real R2 credentials in actual production).
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
